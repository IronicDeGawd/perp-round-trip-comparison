# Copy to .env.local and fill in. .env* is gitignored, never commit real keys. Run with: node --env-file=.env.local ...
# All values are TESTNET throwaway credentials. Do not use mainnet keys.

# DreamDEX / Hideki (Somnia testnet, chain 50383)
# A throwaway EOA funded with STT (gas) + USDso (perp margin), already
# EIP-7702-delegated to the SessionDelegate batcher (see README).
DREAMDEX_PRIVATE_KEY=0x...

# Hyperliquid testnet
# An agent (API) wallet approved on the master account. Holds no funds; can
# place orders but not withdraw. HL_MASTER is the account the agent trades for.
HL_AGENT_PRIVATE_KEY=0x...
HL_MASTER_ADDRESS=0x...

# Optional: port for the board server (default 8800)
PORT=8800
